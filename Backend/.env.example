# Copy to .env and fill in real values. NEVER commit .env — see ../SECURITY.md
# Rotate any value that has ever been committed; assume it is compromised.

# Port the Express server binds to
PORT=

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase anonymous key. Public by design — safe in the browser ONLY if
# row-level security is enabled on every table. See DATA_MODEL.md.
SUPABASE_ANON_KEY=

# Postgres connection string. CONTAINS THE DATABASE PASSWORD and bypasses
# row-level security. Server-side only — never expose to the browser,
# never give it a VITE_ prefix.
DATABASE_URL=

# Comma-separated origins allowed by CORS, e.g. http://localhost:5173
ALLOWED_ORIGINS=

# Log level: error | warn | info | debug
LOG_LEVEL=

# Build identity, injected by CI (reported on /health)
GIT_SHA=
APP_VERSION=

# Feature flags, comma separated: NAME=true,OTHER=false
FEATURE_FLAGS=
