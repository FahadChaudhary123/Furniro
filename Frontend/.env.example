# Copy to .env.local for local overrides. NEVER put a secret in this file.
#
# Vite inlines EVERY variable prefixed VITE_ into the public bundle as a string
# literal. Anything here is readable by any visitor via view-source, and cannot be
# un-published after a deploy. See ../SECURITY.md#the-vite-rule.

# Base URL of the Furniro API. Defaults to http://localhost:3000/api when unset.
VITE_API_URL=
